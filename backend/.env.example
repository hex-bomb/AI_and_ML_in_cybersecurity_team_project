# Переменные окружения (ТЗ раздел 9). Рабочие секреты заполняет оператор,
# не коммитим. Приложение не требует наличия ключей модели для старта.
#
# Внутри docker compose DATABASE_URL и ELASTICSEARCH_URL переопределяются
# адресами docker-сети (postgres:5432, elasticsearch:9200), поэтому этот файл
# работает и для запуска с хоста, и в контейнерах.

# ── Инфраструктура ──────────────────────────────────────────────
# Асинхронный драйвер PostgreSQL. Формат pgx, миграции применяет
# golang-migrate по тому же адресу.
DATABASE_URL=postgresql+asyncpg://kb:dev@localhost:55432/kb
# Общий том файлов оригиналов и JSON ParsedDocument для API и worker.
FILE_STORAGE_ROOT=./var/files
# Слушающий порт API.
API_PORT=8000

# ── Хранилище поисковых документов и векторов ───────────────────
ELASTICSEARCH_URL=http://localhost:59200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# ── Эмбеддер: локальный инференс через ONNX, без Python ────────
# Модель мультиязычная — база знаний русская. intfloat/multilingual-e5-small
# и intfloat/multilingual-e5-base дают 384/768 измерений; E5 требует
# префиксы "query: " и "passage: " на входе.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Размерность вектора должна совпадать с embedding_dimension в настройках KB:
# смена профиля после индексации запрещена (ТЗ 1.2), потребуется переиндексация.
EMBEDDING_DIMENSION=384
# Каталог кэша моделей. ONNX-файл занимает ~448 МБ и скачивается один раз.
EMBEDDING_MODEL_CACHE=./var/models
# Сколько текстов кодируется за один вызов пайплайна.
EMBEDDING_BATCH_SIZE=32
# Сколько горутин считают одновременно. Одна сессия hugot обслуживает все:
# заводить сессию на горутину дорого, она держит модель в памяти.
EMBEDDING_CONCURRENCY=2

# Внешний embedding-провайдер по HTTP. Пусто — используется локальный hugot.
EMBEDDING_PRIMARY_BASE_URL=
EMBEDDING_PRIMARY_API_KEY=

# ── LLM: локальная модель через Ollama ──────────────────────────
# Адрес указывает на корень сервера Ollama: адаптер сам строит /api/chat.
# Для контейнерного запуска локальный сервис на хосте доступен как
# http://host.docker.internal:<порт> (в compose настроен extra_hosts).
LLM_PRIMARY_BASE_URL=http://localhost:11434
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_MODEL=qwen3:4b
# Температура ответов. Ниже 0.4 модель повторяет одну формулировку на все
# вопросы, выше 0.8 начинает выдумывать.
LLM_TEMPERATURE=0.75
# Сколько раз агент может дёрнуть kb_search, прежде чем ответить.
LLM_MAX_TOOL_ROUNDS=2
# Токенов на один раунд с инструментом: поиск вернул фрагменты, а не ответ.
LLM_TOOL_ROUND_TOKENS=256

# ── Права и локальный режим ────────────────────────────────────
# Локальная сборка работает без JWT и без ролей: один пользователь, один
# tenant. Токен появляется в рабочем окружении.
AUTH_MODE=local
LOCAL_TENANT_ID=11111111-1111-4111-8111-111111111111
CORS_ALLOWED_ORIGINS=http://localhost:5174

# ── Размер и форматы загрузки ──────────────────────────────────
MAX_UPLOAD_BYTES=20971520
ALLOWED_UPLOAD_EXTENSIONS=.md,.markdown,.docx,.pdf

# ── Compose ────────────────────────────────────────────────────
POSTGRES_DB=kb
POSTGRES_USER=kb
POSTGRES_PASSWORD=dev
POSTGRES_PORT=55432
ELASTICSEARCH_PORT=59200
