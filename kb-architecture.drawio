    <mxCell id="rb2" value="Реализация Signal + вес в конфиге + включение в search.Chain; прогон kb eval до выката. Поле в индексе — через новый шаблон и alias." style="fillColor=#ffffff;strokeColor=#666666;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s3">
     <mxGeometry x="258" y="214" width="520" height="68" as="geometry" />
    </mxCell>
    <mxCell id="rc2" value="Searcher, RRF, остальные сигналы" style="fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s3">
     <mxGeometry x="786" y="214" width="274" height="68" as="geometry" />
    </mxCell>
    <mxCell id="ra3" value="Новая производная функция (конфликты, граф)" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s3">
     <mxGeometry x="10" y="288" width="240" height="68" as="geometry" />
    </mxCell>
    <mxCell id="rb3" value="Handler события в jobs/ + флаг feature.&amp;lt;имя&amp;gt; + миграция goose для своих таблиц; вход — события v1, выход — таблицы или поля в индексе." style="fillColor=#ffffff;strokeColor=#666666;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s3">
     <mxGeometry x="258" y="288" width="520" height="68" as="geometry" />
    </mxCell>
    <mxCell id="rc3" value="ingest, normalize, index" style="fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s3">
     <mxGeometry x="786" y="288" width="274" height="68" as="geometry" />
    </mxCell>
    <mxCell id="ra4" value="Новая модель эмбеддингов" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s3">
     <mxGeometry x="10" y="362" width="240" height="68" as="geometry" />
    </mxCell>
    <mxCell id="rb4" value="Embedder через Factory по конфигу; новое поле vec_v2; kb reindex из lake; переключение alias; откат — вернуть alias." style="fillColor=#ffffff;strokeColor=#666666;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s3">
     <mxGeometry x="258" y="362" width="520" height="68" as="geometry" />
    </mxCell>
    <mxCell id="rc4" value="остальной код, старые документы" style="fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s3">
     <mxGeometry x="786" y="362" width="274" height="68" as="geometry" />
    </mxCell>
    <mxCell id="ra5" value="Новый канал уведомлений" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s3">
     <mxGeometry x="10" y="436" width="240" height="68" as="geometry" />
    </mxCell>
    <mxCell id="rb5" value="notify.Channel (email, Slack, webhook) + регистрация в notify.Registry." style="fillColor=#ffffff;strokeColor=#666666;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s3">
     <mxGeometry x="258" y="436" width="520" height="68" as="geometry" />
    </mxCell>
    <mxCell id="rc5" value="событие comment.created и правила подписок" style="fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s3">
     <mxGeometry x="786" y="436" width="274" height="68" as="geometry" />
    </mxCell>
    <mxCell id="ra6" value="Новый клиент (бот, мобильное приложение)" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s3">
     <mxGeometry x="10" y="510" width="240" height="68" as="geometry" />
    </mxCell>
    <mxCell id="rb6" value="Работает по тому же OpenAPI с OAuth 2.1 + PKCE; новые endpoint-ы добавляются в контракт обратно-совместимо." style="fillColor=#ffffff;strokeColor=#666666;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s3">
     <mxGeometry x="258" y="510" width="520" height="68" as="geometry" />
    </mxCell>
    <mxCell id="rc6" value="домен и права" style="fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s3">
     <mxGeometry x="786" y="510" width="274" height="68" as="geometry" />
    </mxCell>
    <mxCell id="s4" value="&lt;b&gt;4. Принципы разработки&lt;/b&gt;" style="fillColor=#fbfbfb;strokeColor=#9e9e9e;fontSize=12;whiteSpace=wrap;rounded=1;arcSize=4;verticalAlign=top;strokeWidth=1.5;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="1">
     <mxGeometry x="1330" y="660" width="1070" height="610" as="geometry" />
    </mxCell>
    <mxCell id="pr0" value="&lt;b&gt;Модульный монолит.&lt;/b&gt; Один бинарник kb, режимы api/worker. Границы — пакеты internal/&amp;lt;feature&amp;gt;; микросервисы только при реальной боли." style="fillColor=#ffffff;strokeColor=#666666;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s4">
     <mxGeometry x="10" y="36" width="520" height="74" as="geometry" />
    </mxCell>
    <mxCell id="pr1" value="&lt;b&gt;Ports &amp; Adapters.&lt;/b&gt; Интерфейс объявляет потребитель. Домен не импортирует pgx, go-elasticsearch, minio-go; адаптеры живут в internal/store/*." style="fillColor=#ffffff;strokeColor=#666666;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s4">
     <mxGeometry x="10" y="116" width="520" height="74" as="geometry" />
    </mxCell>
    <mxCell id="pr2" value="&lt;b&gt;Явный DI.&lt;/b&gt; Всё собирается конструкторами в cmd/kb/main.go; Registry и Factory строятся из конфига. Без глобальных переменных, wire и fx." style="fillColor=#ffffff;strokeColor=#666666;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s4">
     <mxGeometry x="10" y="196" width="520" height="74" as="geometry" />
    </mxCell>
    <mxCell id="pr3" value="&lt;b&gt;Envelope + extra.&lt;/b&gt; Одна схема документа. Новое поле сначала живёт в extra и становится первоклассным после двух потребителей." style="fillColor=#ffffff;strokeColor=#666666;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s4">
     <mxGeometry x="10" y="276" width="520" height="74" as="geometry" />
    </mxCell>
    <mxCell id="pr4" value="&lt;b&gt;Transactional outbox.&lt;/b&gt; Job создаётся в той же PG-транзакции, что и запись (River). Все job идемпотентны: ключ doc_id + content_hash." style="fillColor=#ffffff;strokeColor=#666666;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s4">
     <mxGeometry x="10" y="356" width="520" height="74" as="geometry" />
    </mxCell>
    <mxCell id="pr5" value="&lt;b&gt;ACL везде.&lt;/b&gt; Фильтр в запросе к ES, post-check can_read в PG, автотест матрицы «пользователь × документ» в CI. Deny-правил нет." style="fillColor=#ffffff;strokeColor=#666666;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s4">
     <mxGeometry x="10" y="436" width="520" height="74" as="geometry" />
    </mxCell>
    <mxCell id="pr6" value="&lt;b&gt;Lake — источник правды.&lt;/b&gt; Индекс, граф, PageRank — производные; команда kb reindex пересобирает их из MinIO и ClickHouse." style="fillColor=#ffffff;strokeColor=#666666;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s4">
     <mxGeometry x="10" y="516" width="520" height="74" as="geometry" />
    </mxCell>
    <mxCell id="pr7" value="&lt;b&gt;Фичи за флагами.&lt;/b&gt; Каждая умная функция включается конфигом и выключается без потери данных; флаг = ключ конфига + строка в PG." style="fillColor=#ffffff;strokeColor=#666666;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s4">
     <mxGeometry x="540" y="36" width="520" height="74" as="geometry" />
    </mxCell>
    <mxCell id="pr8" value="&lt;b&gt;Eval-gate.&lt;/b&gt; Любое изменение ранжирования, чанкинга или модели проходит kb eval (nDCG@10, Recall@50) до выката; результат — в CI." style="fillColor=#ffffff;strokeColor=#666666;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s4">
     <mxGeometry x="540" y="116" width="520" height="74" as="geometry" />
    </mxCell>
    <mxCell id="pr9" value="&lt;b&gt;OpenAPI-first.&lt;/b&gt; Контракт → Go-сервер (oapi-codegen) и TS-клиент. Внутри /api/v1 только обратно-совместимые изменения." style="fillColor=#ffffff;strokeColor=#666666;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s4">
     <mxGeometry x="540" y="196" width="520" height="74" as="geometry" />
    </mxCell>
    <mxCell id="pr10" value="&lt;b&gt;Наблюдаемость с первого дня.&lt;/b&gt; slog в JSON, /metrics, trace id в логах, метрика lag каждого коннектора и глубина очереди River." style="fillColor=#ffffff;strokeColor=#666666;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s4">
     <mxGeometry x="540" y="276" width="520" height="74" as="geometry" />
    </mxCell>
    <mxCell id="pr11" value="&lt;b&gt;Ошибки и таймауты.&lt;/b&gt; Оборачиваем ошибки (%w), ctx везде, таймаут на каждый внешний вызов, retry с backoff только внутри job." style="fillColor=#ffffff;strokeColor=#666666;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s4">
     <mxGeometry x="540" y="356" width="520" height="74" as="geometry" />
    </mxCell>
    <mxCell id="pr12" value="&lt;b&gt;Тесты.&lt;/b&gt; Unit на домен с fake-портами; integration на testcontainers (PG, ES, CH, MinIO); golden-тесты парсеров и чанкера." style="fillColor=#ffffff;strokeColor=#666666;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s4">
     <mxGeometry x="540" y="436" width="520" height="74" as="geometry" />
    </mxCell>
    <mxCell id="pr13" value="&lt;b&gt;Границы проверяет линтер.&lt;/b&gt; depguard / go-arch-lint: домен не видит store/*, feature-пакеты не импортируют друг друга — только порты и события." style="fillColor=#ffffff;strokeColor=#666666;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s4">
     <mxGeometry x="540" y="516" width="520" height="74" as="geometry" />
    </mxCell>
    <mxCell id="s5" value="&lt;b&gt;5. К чему приходим: вектор развития (ориентиры, не обещания)&lt;/b&gt;" style="fillColor=#fbfbfb;strokeColor=#9e9e9e;fontSize=12;whiteSpace=wrap;rounded=1;arcSize=4;verticalAlign=top;strokeWidth=1.5;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="1">
     <mxGeometry x="20" y="1290" width="2380" height="340" as="geometry" />
    </mxCell>
    <mxCell id="stA" value="&lt;b&gt;A · Сейчас: PoC/MVP&lt;/b&gt; (1 ВМ, 50–200 документов)&lt;br&gt;• Docker Compose на одной ВМ&lt;br&gt;• очередь = Postgres/River, Kafka нет&lt;br&gt;• по одному узлу ES / ClickHouse / PG / MinIO&lt;br&gt;• TEI на CPU, Keycloak, 2–3 источника&lt;br&gt;• ворота: 0 утечек прав, nDCG@10 не ниже BM25" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s5">
     <mxGeometry x="10" y="150" width="570" height="120" as="geometry" />
    </mxCell>
    <mxCell id="stB" value="&lt;b&gt;B · Команда&lt;/b&gt; (до ~10 тыс. документов)&lt;br&gt;• ML-контейнеры на отдельной ВМ с GPU&lt;br&gt;• desktop-заметки, комментарии, уведомления&lt;br&gt;• PageRank + freshness, аналитика в ClickHouse&lt;br&gt;• SCIM, бэкапы, мониторинг с алертами&lt;br&gt;• Slack и почта как коннекторы" style="fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s5">
     <mxGeometry x="600" y="130" width="570" height="140" as="geometry" />
    </mxCell>
    <mxCell id="stC" value="&lt;b&gt;C · Продукт&lt;/b&gt; (сотни тыс. – млн чанков)&lt;br&gt;• EventBus: River → Kafka/NATS (интерфейс прежний)&lt;br&gt;• worker масштабируется горизонтально&lt;br&gt;• кластер ES, rerank, обученное ранжирование (LTR)&lt;br&gt;• конфликты знаний, выборочный граф&lt;br&gt;• несколько тенантов в одном кластере" style="fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s5">
     <mxGeometry x="1190" y="110" width="570" height="160" as="geometry" />
    </mxCell>
    <mxCell id="stD" value="&lt;b&gt;D · Платформа&lt;/b&gt;&lt;br&gt;• Kubernetes + Helm: self-hosted и SaaS&lt;br&gt;• шардирование ES и ClickHouse по tenant_id&lt;br&gt;• коннекторы вне процесса (gRPC / ingest API)&lt;br&gt;• policy-engine для прав, если AGDLP тесен (напр. OpenFGA)&lt;br&gt;• агентный «глубокий поиск» как отдельный режим" style="fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s5">
     <mxGeometry x="1780" y="90" width="570" height="180" as="geometry" />
    </mxCell>
    <mxCell id="inv" value="&lt;b&gt;Не меняется на всех стадиях:&lt;/b&gt; envelope + extra · события v1 · модель AGDLP и фильтр в индексе · швы-интерфейсы (Connector, Embedder, Signal, EventBus / EventStore) · lake (MinIO + ClickHouse) как источник правды" style="fillColor=#ffffff;strokeColor=#666666;fontSize=11;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s5">
     <mxGeometry x="10" y="282" width="2360" height="46" as="geometry" />
    </mxCell>
