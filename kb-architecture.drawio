    </mxCell>
    <mxCell id="rb1" value="Parser для MIME в parser/&amp;lt;имя&amp;gt;, регистрация в parser.Registry; golden-тест на 3–5 реальных файлах." style="fillColor=#ffffff;strokeColor=#666666;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s3">
