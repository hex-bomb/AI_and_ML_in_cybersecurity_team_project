    <mxCell id="L2_8" value="&lt;b&gt;notify&lt;/b&gt;" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=center;spacingTop=5;html=1;" vertex="1" parent="L2">
