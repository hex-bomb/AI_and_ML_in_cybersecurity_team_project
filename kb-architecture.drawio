    </mxCell>
    <mxCell id="L3" value="&lt;b&gt;Ports: интерфейсы (объявляет потребитель)&lt;/b&gt;" style="fillColor=#ffffff;strokeColor=#666666;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=4;verticalAlign=top;strokeWidth=1.5;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s2">
     <mxGeometry x="670" y="322" width="610" height="140" as="geometry" />
    </mxCell>
    <mxCell id="L3_0" value="&lt;b&gt;Connector&lt;/b&gt;" style="fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=center;spacingTop=5;html=1;" vertex="1" parent="L3">
     <mxGeometry x="8.0" y="24" width="114.0" height="32" as="geometry" />
    </mxCell>
    <mxCell id="L3_1" value="&lt;b&gt;Parser&lt;/b&gt;" style="fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=center;spacingTop=5;html=1;" vertex="1" parent="L3">
     <mxGeometry x="128.0" y="24" width="114.0" height="32" as="geometry" />
