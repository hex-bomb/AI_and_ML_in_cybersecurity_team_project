    <mxCell id="ra2" value="Новый сигнал ранжирования" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s3">
