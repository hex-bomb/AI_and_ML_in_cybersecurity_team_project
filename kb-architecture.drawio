 <diagram id="page1" name="1. Deployment: одна ВМ">
  <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2420" pageHeight="1450" math="0" shadow="0">
   <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />
    <mxCell id="title" value="&lt;b&gt;Развёртывание на одной ВМ (UML/C4 «Deployment diagram»): клиенты → Caddy → Go-монолит → хранилища и ML-контейнеры&lt;/b&gt;" style="text;fontSize=15;strokeColor=none;fillColor=none;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="1">
     <mxGeometry x="20" y="8" width="1800" height="30" as="geometry" />
    </mxCell>
    <mxCell id="c_web" value="&lt;b&gt;Браузер (Web UI)&lt;/b&gt;&lt;br&gt;React + Vite SPA (статика из Caddy)&lt;br&gt;HTTPS :443" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="1">
     <mxGeometry x="30" y="110" width="230" height="80" as="geometry" />
    </mxCell>
    <mxCell id="c_desk" value="&lt;b&gt;Desktop-приложение&lt;/b&gt;&lt;br&gt;Wails (Go + web UI): хоткей → заметка&lt;br&gt;очередь SQLite при отсутствии сети&lt;br&gt;HTTPS :443" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="1">
     <mxGeometry x="30" y="210" width="230" height="100" as="geometry" />
    </mxCell>
    <mxCell id="c_mcp" value="&lt;b&gt;MCP-клиенты&lt;/b&gt;&lt;br&gt;IDE / агенты&lt;br&gt;Streamable HTTP /mcp, OAuth 2.1" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="1">
     <mxGeometry x="30" y="330" width="230" height="80" as="geometry" />
    </mxCell>
    <mxCell id="c_adm" value="&lt;b&gt;Админ&lt;/b&gt;&lt;br&gt;SSH :22 только через VPN" style="fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="1">
     <mxGeometry x="30" y="430" width="230" height="60" as="geometry" />
    </mxCell>
    <mxCell id="ext" value="&lt;b&gt;Существующая инфраструктура демо-компании&lt;/b&gt;&lt;br&gt;&lt;i&gt;(состав уточнить: DNS, прокси, IdP, мониторинг — переиспользуем, если есть)&lt;/i&gt;" style="fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;whiteSpace=wrap;rounded=1;arcSize=4;verticalAlign=top;strokeWidth=1.5;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="1">
     <mxGeometry x="30" y="560" width="250" height="420" as="geometry" />
    </mxCell>
    <mxCell id="x1" value="&lt;b&gt;Источник №1&lt;/b&gt;&lt;br&gt;Markdown / HTML / TXT: папка или zip (импорт по HTTPS/SFTP)" style="fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="ext">
     <mxGeometry x="10" y="70" width="230" height="70" as="geometry" />
    </mxCell>
    <mxCell id="x2" value="&lt;b&gt;Источник №2&lt;/b&gt;&lt;br&gt;PDF / DOCX → текст через Tika" style="fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="ext">
     <mxGeometry x="10" y="150" width="230" height="56" as="geometry" />
    </mxCell>
    <mxCell id="x3" value="&lt;b&gt;Следующий коннектор&lt;/b&gt;&lt;br&gt;Slack (фаза 1.5): pull + Events API" style="fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="ext">
     <mxGeometry x="10" y="216" width="230" height="56" as="geometry" />
    </mxCell>
    <mxCell id="x4" value="&lt;b&gt;Корпоративный IdP&lt;/b&gt; (если есть)&lt;br&gt;OIDC / SAML → federation в Keycloak" style="fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="ext">
     <mxGeometry x="10" y="282" width="230" height="56" as="geometry" />
    </mxCell>
    <mxCell id="vm" value="&lt;b&gt;VM-1 · Linux (Ubuntu LTS) · Docker Engine + compose v2&lt;/b&gt;&lt;br&gt;8 vCPU · 32 GB RAM · 200 GB SSD · без GPU (оценка для PoC на 50–200 документов)" style="fillColor=#f4f8ff;strokeColor=#2c3e50;fontSize=12;whiteSpace=wrap;rounded=1;arcSize=4;verticalAlign=top;strokeWidth=1.5;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="1">
     <mxGeometry x="310" y="50" width="1500" height="1360" as="geometry" />
    </mxCell>
    <mxCell id="g_edge" value="&lt;b&gt;net: edge&lt;/b&gt; (наружу публикуется только Caddy)" style="fillColor=#fbfbfb;strokeColor=#9e9e9e;fontSize=11;whiteSpace=wrap;rounded=1;arcSize=4;dashed=1;verticalAlign=top;strokeWidth=1.5;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="vm">
     <mxGeometry x="20" y="70" width="270" height="440" as="geometry" />
    </mxCell>
    <mxCell id="caddy" value="&lt;b&gt;caddy&lt;/b&gt; · :80, :443 (published)&lt;br&gt;• TLS (ACME или корпоративный сертификат)&lt;br&gt;• статика React: /srv/web&lt;br&gt;• app.&amp;lt;домен&amp;gt; → kb-api:8081&lt;br&gt;  (/api, /mcp, /.well-known)&lt;br&gt;• auth.&amp;lt;домен&amp;gt; → keycloak:8180&lt;br&gt;• grafana.&amp;lt;домен&amp;gt; → grafana:3000&lt;br&gt;RAM ≈ 50 MB" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="g_edge">
     <mxGeometry x="10" y="36" width="250" height="180" as="geometry" />
    </mxCell>
    <mxCell id="kc" value="&lt;b&gt;keycloak&lt;/b&gt; · :8180 (HTTP), :9000 (mgmt)&lt;br&gt;• realm kb из realm.json (в репозитории)&lt;br&gt;• клиенты: web (code+PKCE), desktop (public,&lt;br&gt;  loopback), mcp (resource), ingest (service)&lt;br&gt;• federation: корпоративный IdP, OIDC/SAML&lt;br&gt;• БД: postgres:5432/keycloak&lt;br&gt;RAM ≈ 1 GB" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="g_edge">
     <mxGeometry x="10" y="236" width="250" height="195" as="geometry" />
    </mxCell>
    <mxCell id="g_app" value="&lt;b&gt;net: app&lt;/b&gt; · один образ kb, две команды" style="fillColor=#fbfbfb;strokeColor=#9e9e9e;fontSize=11;whiteSpace=wrap;rounded=1;arcSize=4;dashed=1;verticalAlign=top;strokeWidth=1.5;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="vm">
     <mxGeometry x="330" y="70" width="290" height="500" as="geometry" />
    </mxCell>
    <mxCell id="api" value="&lt;b&gt;kb-api&lt;/b&gt; (Go) · :8081&lt;br&gt;/api/v1 · /mcp · /healthz · /metrics&lt;br&gt;• authn: проверка JWT (JWKS из Keycloak, кэш)&lt;br&gt;• поиск: ES BM25 ∥ kNN → RRF → сигналы&lt;br&gt;• AGDLP: фильтр прав + post-check в PG&lt;br&gt;• комментарии, оценки, права, админка&lt;br&gt;• логи поиска → ClickHouse (batch)&lt;br&gt;RAM ≈ 300 MB" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="g_app">
     <mxGeometry x="10" y="36" width="270" height="200" as="geometry" />
    </mxCell>
    <mxCell id="wrk" value="&lt;b&gt;kb-worker&lt;/b&gt; (Go) · :8082&lt;br&gt;/healthz · /metrics&lt;br&gt;• River-воркеры: normalize → enrich → index → derive&lt;br&gt;• импорт источников (pull по курсору)&lt;br&gt;• periodic: PageRank, freshness, lag коннекторов&lt;br&gt;• клиенты: TEI, Tika, Ollama (HTTP)&lt;br&gt;• запись: PG, ES, ClickHouse, MinIO&lt;br&gt;RAM ≈ 500 MB" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="g_app">
     <mxGeometry x="10" y="256" width="270" height="225" as="geometry" />
    </mxCell>
    <mxCell id="g_data" value="&lt;b&gt;net: data&lt;/b&gt; (internal)" style="fillColor=#fbfbfb;strokeColor=#9e9e9e;fontSize=11;whiteSpace=wrap;rounded=1;arcSize=4;dashed=1;verticalAlign=top;strokeWidth=1.5;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="vm">
     <mxGeometry x="670" y="70" width="270" height="705" as="geometry" />
    </mxCell>
    <mxCell id="pg" value="&lt;b&gt;postgres&lt;/b&gt; · :5432&lt;br&gt;БД kb: users, groups, acl, документы (реестр),&lt;br&gt;комментарии, рёбра графа, очередь River;&lt;br&gt;БД keycloak&lt;br&gt;RAM ≈ 1 GB · vol: /srv/kb/pg" style="fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="g_data">
     <mxGeometry x="10" y="36" width="250" height="125" as="geometry" />
    </mxCell>
    <mxCell id="es" value="&lt;b&gt;elasticsearch&lt;/b&gt; · :9200 (single-node)&lt;br&gt;heap 2 GB (Xms=Xmx), security вкл., API-key для kb&lt;br&gt;индекс kb-docs-v1, alias kb-docs&lt;br&gt;анализаторы: russian + без стемминга (коды)&lt;br&gt;dense_vector 1024, HNSW, cosine&lt;br&gt;поля прав: space_id[], acl[]&lt;br&gt;RAM ≈ 4 GB · vol: /srv/kb/es" style="fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="g_data">
     <mxGeometry x="10" y="171" width="250" height="190" as="geometry" />
    </mxCell>
    <mxCell id="ch" value="&lt;b&gt;clickhouse&lt;/b&gt; · :8123 (HTTP), :9000 (native)&lt;br&gt;raw_events (журнал lake), search_log,&lt;br&gt;feedback_events, ingest_metrics&lt;br&gt;RAM ≈ 2 GB · vol: /srv/kb/ch" style="fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="g_data">
     <mxGeometry x="10" y="371" width="250" height="110" as="geometry" />
    </mxCell>
    <mxCell id="s3" value="&lt;b&gt;object storage&lt;/b&gt; · :9000 (S3 API), :9001 (UI)&lt;br&gt;MinIO (или Garage/SeaweedFS: проверить статус&lt;br&gt;лицензии community-версии MinIO)&lt;br&gt;bucket kb-raw: sha256/… (сырые файлы)&lt;br&gt;RAM ≈ 0,5 GB · vol: /srv/kb/minio" style="fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="g_data">
     <mxGeometry x="10" y="491" width="250" height="125" as="geometry" />
    </mxCell>
    <mxCell id="g_obs" value="&lt;b&gt;profile: ops&lt;/b&gt;" style="fillColor=#fbfbfb;strokeColor=#9e9e9e;fontSize=11;whiteSpace=wrap;rounded=1;arcSize=4;dashed=1;verticalAlign=top;strokeWidth=1.5;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="vm">
     <mxGeometry x="960" y="70" width="500" height="270" as="geometry" />
    </mxCell>
    <mxCell id="prom" value="&lt;b&gt;prometheus&lt;/b&gt; · :9090&lt;br&gt;скрейп /metrics: kb-api, kb-worker,&lt;br&gt;ES/CH/PG-экспортеры; хранение 15 дней" style="fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="g_obs">
     <mxGeometry x="10" y="36" width="230" height="95" as="geometry" />
    </mxCell>
    <mxCell id="graf" value="&lt;b&gt;grafana&lt;/b&gt; · :3000&lt;br&gt;grafana.&amp;lt;домен&amp;gt; через Caddy,&lt;br&gt;вход по SSO (Keycloak)" style="fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="g_obs">
     <mxGeometry x="250" y="36" width="240" height="95" as="geometry" />
    </mxCell>
    <mxCell id="loki" value="&lt;b&gt;loki&lt;/b&gt; :3100 + promtail (опц.)&lt;br&gt;логи контейнеров: slog в JSON" style="fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="g_obs">
     <mxGeometry x="10" y="141" width="230" height="80" as="geometry" />
    </mxCell>
    <mxCell id="alert" value="&lt;b&gt;alertmanager&lt;/b&gt; · :9093 (опц.)&lt;br&gt;lag коннектора, диск, ES red" style="fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="g_obs">
     <mxGeometry x="250" y="141" width="240" height="80" as="geometry" />
    </mxCell>
    <mxCell id="bkp" value="&lt;b&gt;backup&lt;/b&gt; (cron-контейнер, restic)&lt;br&gt;• pg_dump: kb + keycloak (ежедневно)&lt;br&gt;• clickhouse-backup → внешний S3&lt;br&gt;• bucket kb-raw → restic / mc mirror&lt;br&gt;• Elasticsearch НЕ бэкапим: kb reindex из lake&lt;br&gt;• восстановление проверять учениями" style="fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="vm">
     <mxGeometry x="960" y="360" width="500" height="130" as="geometry" />
    </mxCell>
    <mxCell id="host" value="&lt;b&gt;Хост и безопасность&lt;/b&gt;&lt;br&gt;• compose profiles: core · ml · ops · phase2&lt;br&gt;• nftables/ufw: наружу только 80/443; SSH — через VPN&lt;br&gt;• секреты: .env + sops/age; отдельный пользователь kb&lt;br&gt;• тома: /srv/kb/{pg,ch,es,minio,models}&lt;br&gt;• sysctl vm.max_map_count=262144 (для Elasticsearch)&lt;br&gt;• mem_limit на каждый контейнер, restart: unless-stopped" style="fillColor=#f5f5f5;strokeColor=#666666;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="vm">
     <mxGeometry x="960" y="505" width="500" height="145" as="geometry" />
    </mxCell>
    <mxCell id="g_ml" value="&lt;b&gt;net: ml&lt;/b&gt; (internal; CPU-инференс на PoC, образы TEI/Ollama с кэшем моделей в /srv/kb/models)" style="fillColor=#fbfbfb;strokeColor=#9e9e9e;fontSize=11;whiteSpace=wrap;rounded=1;arcSize=4;dashed=1;verticalAlign=top;strokeWidth=1.5;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="vm">
     <mxGeometry x="20" y="810" width="1460" height="250" as="geometry" />
    </mxCell>
    <mxCell id="emb" value="&lt;b&gt;tei-embed&lt;/b&gt; · :8090 → 80&lt;br&gt;HF Text Embeddings Inference (CPU)&lt;br&gt;модель: BAAI/bge-m3 (мультиязычная,&lt;br&gt;1024-мерные эмбеддинги, ctx 8192)&lt;br&gt;RAM ≈ 3,5 GB" style="fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="g_ml">
     <mxGeometry x="10" y="40" width="270" height="130" as="geometry" />
    </mxCell>
    <mxCell id="rr" value="&lt;b&gt;tei-rerank&lt;/b&gt; · :8091 → 80 (опц.)&lt;br&gt;TEI, cross-encoder&lt;br&gt;модель: BAAI/bge-reranker-v2-m3&lt;br&gt;включается флагом, top-50&lt;br&gt;RAM ≈ 3 GB" style="fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="g_ml">
     <mxGeometry x="300" y="40" width="270" height="130" as="geometry" />
    </mxCell>
    <mxCell id="llm" value="&lt;b&gt;ollama&lt;/b&gt; · :11434 (опц.)&lt;br&gt;LLM: локальная instruct ~7–8B, Q4&lt;br&gt;кандидат: Qwen3-8B (выбрать по eval на&lt;br&gt;русском); нужен для «ответа по документам»&lt;br&gt;и детектора конфликтов; RAM ≈ 7 GB" style="fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="g_ml">
     <mxGeometry x="590" y="40" width="270" height="130" as="geometry" />
    </mxCell>
    <mxCell id="tika" value="&lt;b&gt;tika&lt;/b&gt; · :9998 (опц.)&lt;br&gt;Apache Tika server: PDF / DOCX / PPTX → текст&lt;br&gt;профиль docs; RAM ≈ 1 GB" style="fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="g_ml">
     <mxGeometry x="880" y="40" width="270" height="130" as="geometry" />
    </mxCell>
    <mxCell id="stt" value="&lt;b&gt;whisper-server&lt;/b&gt; · :8092 (фаза 2)&lt;br&gt;faster-whisper: диктовка в desktop&lt;br&gt;модель: small/medium для CPU&lt;br&gt;(выбрать по качеству на русском)" style="fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="g_ml">
     <mxGeometry x="1170" y="40" width="270" height="130" as="geometry" />
    </mxCell>
    <mxCell id="mlnote" value="Все модели — за интерфейсами Embedder / Reranker / LLM; название и версия модели хранятся в документе → смена модели = новое поле vec_v2 + reindex из lake, без остановки поиска." style="fillColor=#ffffff;strokeColor=#666666;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="g_ml">
     <mxGeometry x="10" y="180" width="1430" height="50" as="geometry" />
    </mxCell>
    <mxCell id="ram" value="&lt;b&gt;Бюджет RAM (оценка, не замер)&lt;/b&gt;&lt;br&gt;ES 4 · ClickHouse 2 · Postgres 1 · Keycloak 1 · MinIO 0,5 · TEI-embed 3,5 · TEI-rerank 3 · LLM 7 · Tika 1 · Go ×2 1 · ops 1,5 · ОС 2&lt;br&gt;&lt;b&gt;≈ 27 ГБ → ВМ 32 ГБ.&lt;/b&gt; Без LLM и reranker ≈ 17 ГБ → хватит 24 ГБ.&lt;br&gt;Диск: данные 50–200 документов — мегабайты; основное место занимают модели (порядка 10–15 ГБ) и образы." style="fillColor=#ffffff;strokeColor=#666666;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="vm">
     <mxGeometry x="20" y="1080" width="740" height="120" as="geometry" />
    </mxCell>
    <mxCell id="order" value="&lt;b&gt;Порядок запуска&lt;/b&gt; (depends_on + healthcheck)&lt;br&gt;postgres → keycloak, clickhouse, elasticsearch, minio →&lt;br&gt;kb migrate (PG, ClickHouse, шаблоны индекса ES) →&lt;br&gt;kb-api, kb-worker → caddy&lt;br&gt;ML-контейнеры стартуют независимо; kb-worker ждёт tei-embed по /health" style="fillColor=#ffffff;strokeColor=#666666;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="vm">
     <mxGeometry x="780" y="1080" width="700" height="120" as="geometry" />
    </mxCell>
    <mxCell id="leg" value="&lt;b&gt;Легенда&lt;/b&gt;" style="fillColor=#ffffff;strokeColor=#666666;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=4;verticalAlign=top;strokeWidth=1.5;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="vm">
     <mxGeometry x="20" y="1215" width="1460" height="125" as="geometry" />
    </mxCell>
    <mxCell id="lg0" value="клиенты и edge/app (Go)" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=center;spacingTop=5;html=1;" vertex="1" parent="leg">
     <mxGeometry x="12" y="30" width="195" height="26" as="geometry" />
    </mxCell>
    <mxCell id="lg1" value="данные" style="fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=center;spacingTop=5;html=1;" vertex="1" parent="leg">
     <mxGeometry x="217" y="30" width="195" height="26" as="geometry" />
    </mxCell>
    <mxCell id="lg2" value="ML / LLM" style="fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=center;spacingTop=5;html=1;" vertex="1" parent="leg">
     <mxGeometry x="422" y="30" width="195" height="26" as="geometry" />
    </mxCell>
    <mxCell id="lg3" value="ops и backup" style="fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=center;spacingTop=5;html=1;" vertex="1" parent="leg">
     <mxGeometry x="627" y="30" width="195" height="26" as="geometry" />
    </mxCell>
    <mxCell id="lg4" value="внешнее / уточнить" style="fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=center;spacingTop=5;html=1;" vertex="1" parent="leg">
     <mxGeometry x="832" y="30" width="195" height="26" as="geometry" />
    </mxCell>
    <mxCell id="lg5" value="хост" style="fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=center;spacingTop=5;html=1;" vertex="1" parent="leg">
     <mxGeometry x="1037" y="30" width="195" height="26" as="geometry" />
    </mxCell>
    <mxCell id="lgt" value="Сплошная стрелка — синхронный вызов; пунктир — опционально или асинхронно (batch, фаза 1.5+). Порты внутри сетей не публикуются: на хосте открыты только 80/443. Версии образов фиксировать по digest при первом развёртывании." style="text;fontSize=10.5;strokeColor=none;fillColor=none;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="leg">
     <mxGeometry x="12" y="66" width="1430" height="50" as="geometry" />
    </mxCell>
    <mxCell id="libs" value="&lt;b&gt;Go-библиотеки backend&lt;/b&gt; (рекомендация; актуальность версий не проверялась)&lt;br&gt;&lt;b&gt;HTTP/API:&lt;/b&gt; net/http + chi; oapi-codegen (OpenAPI → Go + TS-клиент)&lt;br&gt;&lt;b&gt;БД и очередь:&lt;/b&gt; pgx v5, sqlc, goose; River (джобы на Postgres)&lt;br&gt;&lt;b&gt;Хранилища:&lt;/b&gt; go-elasticsearch v8, clickhouse-go v2, minio-go v7&lt;br&gt;&lt;b&gt;Auth:&lt;/b&gt; coreos/go-oidc, golang.org/x/oauth2, lestrrat-go/jwx, alexedwards/scs&lt;br&gt;&lt;b&gt;MCP:&lt;/b&gt; modelcontextprotocol/go-sdk (проверить поддержку spec 2026-07-28)&lt;br&gt;&lt;b&gt;ML/LLM:&lt;/b&gt; HTTP-клиент TEI; openai-go (OpenAI-совместимый API → Ollama)&lt;br&gt;&lt;b&gt;Парсинг:&lt;/b&gt; yuin/goldmark, html-to-markdown, golang.org/x/net/html, клиент Tika&lt;br&gt;&lt;b&gt;Граф:&lt;/b&gt; gonum (network.PageRank)&lt;br&gt;&lt;b&gt;Коннекторы:&lt;/b&gt; slack-go/slack (фаза 1.5)&lt;br&gt;&lt;b&gt;Наблюдаемость:&lt;/b&gt; log/slog, prometheus/client_golang; OpenTelemetry (фаза 2)&lt;br&gt;&lt;b&gt;Прочее:&lt;/b&gt; caarlos0/env, go-playground/validator, google/uuid (v7), cenkalti/backoff, x/time/rate&lt;br&gt;&lt;b&gt;Тесты и линтеры:&lt;/b&gt; testify, testcontainers-go, golangci-lint + depguard" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="1">
     <mxGeometry x="1850" y="50" width="550" height="262" as="geometry" />
    </mxCell>
    <mxCell id="mods" value="&lt;b&gt;ML/LLM-модели&lt;/b&gt; (кандидаты на момент моих знаний: проверить актуальность и лицензию)&lt;br&gt;&lt;b&gt;Эмбеддинги:&lt;/b&gt; BAAI/bge-m3 через TEI на CPU — 1024-мерные, мультиязычные&lt;br&gt;&lt;b&gt;Reranker (опц.):&lt;/b&gt; BAAI/bge-reranker-v2-m3 через TEI&lt;br&gt;&lt;b&gt;LLM (опц.):&lt;/b&gt; instruct ~7–8B в Q4 через Ollama; кандидат Qwen3-8B; выбрать по eval на ваших русскоязычных вопросах&lt;br&gt;&lt;b&gt;STT (фаза 2):&lt;/b&gt; семейство Whisper (faster-whisper), размер по CPU/GPU&lt;br&gt;&lt;b&gt;Критерий выбора:&lt;/b&gt; nDCG@10 на eval-наборе из 100+ ваших вопросов, а не публичные лидерборды" style="fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="1">
     <mxGeometry x="1850" y="330" width="550" height="150" as="geometry" />
    </mxCell>
    <mxCell id="multi" value="&lt;b&gt;Если одной ВМ мало: порядок выноса&lt;/b&gt;" style="fillColor=#ffffff;strokeColor=#666666;fontSize=11;whiteSpace=wrap;rounded=1;arcSize=4;verticalAlign=top;strokeWidth=1.5;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="1">
     <mxGeometry x="1850" y="500" width="550" height="640" as="geometry" />
    </mxCell>
    <mxCell id="mv1" value="&lt;b&gt;1. VM-ML (GPU)&lt;/b&gt;&lt;br&gt;tei-embed, tei-rerank, LLM (vLLM или Ollama).&lt;br&gt;Выносим первой: самая прожорливая и независимая часть;&lt;br&gt;kb-* ходят к ней по HTTP, меняется только URL в конфиге." style="fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="multi">
     <mxGeometry x="10" y="40" width="530" height="85" as="geometry" />
    </mxCell>
    <mxCell id="mv2" value="&lt;b&gt;2. VM-Data&lt;/b&gt;&lt;br&gt;Elasticsearch (heap ≤ 50% RAM), ClickHouse, Postgres, MinIO.&lt;br&gt;Далее — кластер ES отдельно от остальных; Postgres с репликой.&lt;br&gt;Сеть: приватная подсеть, наружу ничего." style="fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="multi">
     <mxGeometry x="10" y="135" width="530" height="85" as="geometry" />
    </mxCell>
    <mxCell id="mv3" value="&lt;b&gt;3. VM-App&lt;/b&gt;&lt;br&gt;Caddy, Keycloak, kb-api, kb-worker.&lt;br&gt;kb-worker масштабируется копиями; kb-api — за балансировщиком;&lt;br&gt;очередь River остаётся в Postgres до стадии C." style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="multi">
     <mxGeometry x="10" y="230" width="530" height="85" as="geometry" />
    </mxCell>
    <mxCell id="mv4" value="&lt;b&gt;4. VM-Ops&lt;/b&gt;&lt;br&gt;Prometheus, Grafana, Loki, Alertmanager, backup-задачи.&lt;br&gt;Отдельно, чтобы мониторинг пережил падение основной ВМ." style="fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="multi">
     <mxGeometry x="10" y="325" width="530" height="70" as="geometry" />
    </mxCell>
    <mxCell id="mvn" value="&lt;b&gt;Как это не ломает код:&lt;/b&gt; те же compose-файлы с разными профилями; адреса сервисов — только в конфиге;&lt;br&gt;между ВМ — TLS (или mTLS), аутентификация сервис-сервис по токенам. Перенос ES/ClickHouse: восстановление из lake командой kb reindex." style="text;fontSize=10.5;strokeColor=none;fillColor=none;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="multi">
     <mxGeometry x="10" y="405" width="530" height="85" as="geometry" />
    </mxCell>
    <mxCell id="multi2" value="&lt;b&gt;Ориентир:&lt;/b&gt; для стадии A хватает одной ВМ (≈27 ГБ с LLM, ≈17 ГБ без).&lt;br&gt;Разбиение — это не архитектурное изменение, а перенос контейнеров." style="text;fontSize=10.5;strokeColor=none;fillColor=none;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="multi">
     <mxGeometry x="10" y="500" width="530" height="70" as="geometry" />
    </mxCell>
    <mxCell id="e0" value="HTTPS :443" style="endArrow=block;endFill=1;html=1;strokeColor=#444444;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;rounded=0;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c_web" target="caddy">
