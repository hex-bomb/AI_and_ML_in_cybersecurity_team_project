 <diagram id="page2" name="2. System design + Go backend">
  <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2420" pageHeight="1660" math="0" shadow="0">
   <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />
    <mxCell id="title" value="&lt;b&gt;System design и Go-backend: стадия MVP (1 ВМ, без Kafka) и вектор развития&lt;/b&gt;" style="text;fontSize=16;strokeColor=none;fillColor=none;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="1">
     <mxGeometry x="20" y="8" width="1800" height="30" as="geometry" />
    </mxCell>
    <mxCell id="s1" value="&lt;b&gt;1. Потоки данных: write path (асинхронно) и read path (синхронно)&lt;/b&gt;" style="fillColor=#fbfbfb;strokeColor=#9e9e9e;fontSize=12;whiteSpace=wrap;rounded=1;arcSize=4;verticalAlign=top;strokeWidth=1.5;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="1">
     <mxGeometry x="20" y="50" width="1290" height="580" as="geometry" />
    </mxCell>
    <mxCell id="wt" value="&lt;b&gt;WRITE&lt;/b&gt;: данные → знания. Идемпотентно (ключ doc_id + content_hash), очередь — таблицы River в Postgres, retry и dead-letter из коробки." style="text;fontSize=11;strokeColor=none;fillColor=none;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s1">
     <mxGeometry x="10" y="30" width="1270" height="24" as="geometry" />
    </mxCell>
    <mxCell id="w1" value="&lt;b&gt;1. Источник&lt;/b&gt;&lt;br&gt;импорт папки / zip,&lt;br&gt;Desktop-заметка,&lt;br&gt;загрузка в Web" style="fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s1">
     <mxGeometry x="10" y="62" width="162" height="112" as="geometry" />
    </mxCell>
    <mxCell id="w2" value="&lt;b&gt;2. Ingest API&lt;/b&gt;&lt;br&gt;POST /api/v1/ingest&lt;br&gt;authn: токен источника&lt;br&gt;или JWT пользователя" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s1">
     <mxGeometry x="192" y="62" width="162" height="112" as="geometry" />
    </mxCell>
    <mxCell id="w3" value="&lt;b&gt;3. Принять&lt;/b&gt;&lt;br&gt;• blob → MinIO (sha256)&lt;br&gt;• PG-транзакция: реестр&lt;br&gt;  документа + job (outbox)" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s1">
     <mxGeometry x="374" y="62" width="162" height="112" as="geometry" />
    </mxCell>
    <mxCell id="w4" value="&lt;b&gt;4. normalize&lt;/b&gt;&lt;br&gt;Parser по MIME&lt;br&gt;→ Document (envelope)&lt;br&gt;ACL, links, tags, owner" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s1">
     <mxGeometry x="556" y="62" width="162" height="112" as="geometry" />
    </mxCell>
    <mxCell id="w5" value="&lt;b&gt;5. enrich&lt;/b&gt;&lt;br&gt;Chunker по заголовкам&lt;br&gt;Embedder → TEI&lt;br&gt;дедуп по content_hash" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s1">
     <mxGeometry x="738" y="62" width="162" height="112" as="geometry" />
    </mxCell>
    <mxCell id="w6" value="&lt;b&gt;6. index&lt;/b&gt;&lt;br&gt;Indexer: upsert в ES&lt;br&gt;(BM25 + vec + ACL);&lt;br&gt;tombstone при удалении" style="fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s1">
     <mxGeometry x="920" y="62" width="162" height="112" as="geometry" />
    </mxCell>
    <mxCell id="w7" value="&lt;b&gt;7. derive&lt;/b&gt; (jobs)&lt;br&gt;PageRank, граф,&lt;br&gt;конфликты, notify —&lt;br&gt;каждая за флагом" style="fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s1">
     <mxGeometry x="1102" y="62" width="162" height="112" as="geometry" />
    </mxCell>
    <mxCell id="lake" value="&lt;b&gt;Журнал lake:&lt;/b&gt; EventStore батчами пишет в ClickHouse raw_events — вместе с MinIO это источник правды для kb reindex" style="fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s1">
     <mxGeometry x="192" y="190" width="360" height="56" as="geometry" />
    </mxCell>
    <mxCell id="rt" value="&lt;b&gt;READ&lt;/b&gt;: запрос → релевантные документы с учётом прав. Все шаги, кроме rerank, — на каждом запросе." style="text;fontSize=11;strokeColor=none;fillColor=none;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s1">
     <mxGeometry x="10" y="262" width="1270" height="24" as="geometry" />
    </mxCell>
    <mxCell id="r1" value="&lt;b&gt;1. Клиент&lt;/b&gt;&lt;br&gt;Web · MCP · Desktop&lt;br&gt;HTTPS через Caddy" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s1">
     <mxGeometry x="10" y="292" width="162" height="112" as="geometry" />
    </mxCell>
    <mxCell id="r2" value="&lt;b&gt;2. Authn&lt;/b&gt;&lt;br&gt;JWT: issuer, aud,&lt;br&gt;exp; JWKS из Keycloak&lt;br&gt;(кэш)" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s1">
     <mxGeometry x="192" y="292" width="162" height="112" as="geometry" />
    </mxCell>
    <mxCell id="r3" value="&lt;b&gt;3. AccessResolver&lt;/b&gt;&lt;br&gt;user → global groups →&lt;br&gt;resource groups →&lt;br&gt;space_id[] и acl[] (кэш)" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s1">
     <mxGeometry x="374" y="292" width="162" height="112" as="geometry" />
    </mxCell>
    <mxCell id="r4" value="&lt;b&gt;4. Searcher&lt;/b&gt;&lt;br&gt;BM25 ∥ kNN в ES,&lt;br&gt;оба с filter по&lt;br&gt;tenant + space_id + acl" style="fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s1">
     <mxGeometry x="556" y="292" width="162" height="112" as="geometry" />
    </mxCell>
    <mxCell id="r5" value="&lt;b&gt;5. Fuse + Signals&lt;/b&gt;&lt;br&gt;RRF в Go →&lt;br&gt;× freshness × authority&lt;br&gt;× quality (0,5…1,5)" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s1">
     <mxGeometry x="738" y="292" width="162" height="112" as="geometry" />
    </mxCell>
    <mxCell id="r6" value="&lt;b&gt;6. Rerank&lt;/b&gt; (опц.)&lt;br&gt;TEI cross-encoder&lt;br&gt;top-50, за флагом" style="fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s1">
     <mxGeometry x="920" y="292" width="162" height="112" as="geometry" />
    </mxCell>
    <mxCell id="r7" value="&lt;b&gt;7. Post-check&lt;/b&gt;&lt;br&gt;can_read(user, ids) в PG,&lt;br&gt;explain, ответ;&lt;br&gt;лог → ClickHouse" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s1">
     <mxGeometry x="1102" y="292" width="162" height="112" as="geometry" />
    </mxCell>
    <mxCell id="fb" value="&lt;b&gt;Обратная связь:&lt;/b&gt; like/dislike + причина → PG и ClickHouse → сигнал quality; комментарий «устарело/ошибка» → уведомление владельцу (notify)" style="fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s1">
     <mxGeometry x="736" y="420" width="544" height="56" as="geometry" />
    </mxCell>
    <mxCell id="per" value="&lt;b&gt;Периодика (River periodic jobs):&lt;/b&gt; PageRank ночью · пересчёт freshness/quality · lag каждого коннектора · conflict scan · notify-digest · retention и tombstone-очистка" style="fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s1">
     <mxGeometry x="10" y="492" width="1270" height="40" as="geometry" />
    </mxCell>
    <mxCell id="s1n" value="Правило: права проверяются дважды — фильтром внутри запроса к индексу (шаг 4) и повторно по Postgres перед выдачей (шаг 7), поэтому устаревший индекс не раскрывает документ." style="text;fontSize=10.5;strokeColor=none;fillColor=none;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s1">
     <mxGeometry x="10" y="540" width="1270" height="30" as="geometry" />
    </mxCell>
    <mxCell id="s2" value="&lt;b&gt;2. Go-backend: структура репозитория и слои&lt;/b&gt;" style="fillColor=#fbfbfb;strokeColor=#9e9e9e;fontSize=12;whiteSpace=wrap;rounded=1;arcSize=4;verticalAlign=top;strokeWidth=1.5;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="1">
     <mxGeometry x="20" y="650" width="1290" height="620" as="geometry" />
    </mxCell>
    <mxCell id="tree" value="kb/&#10;├─ cmd/kb/main.go        composition root; режимы api | worker | migrate | reindex | eval&#10;├─ api/openapi.yaml      контракт → oapi-codegen (Go) + openapi-typescript (фронт)&#10;├─ internal/&#10;│  ├─ platform/          config(env) · slog · httpx · pgxpool · metrics · authn(jwx, oidc)&#10;│  ├─ envelope/          типы: Document · Chunk · Principal · Event(v1) — без логики&#10;│  ├─ ingest/            use-cases: Accept → Normalize → Enrich&#10;│  │  ├─ connector/      интерфейс + Registry · files/ · notes/ · (slack/ позже)&#10;│  │  ├─ parser/         интерфейс + Registry · md/ · html/ · txt/ · tika/&#10;│  │  └─ chunker/ embedder/   интерфейс + Factory(config) · tei/&#10;│  ├─ search/            Searcher · Query · RRF · signal/{freshness,authority,quality}&#10;│  ├─ access/            AGDLP: Resolver · Grants · кэш принципалов&#10;│  ├─ docs/ comments/ feedback/ graph/ conflicts/ notify/      (за флагами)&#10;│  ├─ jobs/              River-воркеры: по одному handler на тип события&#10;│  └─ store/             адаптеры: pg/ es/ ch/ s3/ llm/ tei/ queue/&#10;├─ migrations/           goose (PG) · ch/ (ClickHouse) · es/ (шаблоны индексов)&#10;├─ eval/                 вопросы + разметка + harness (kb eval)&#10;└─ deploy/               compose.yaml · Caddyfile · keycloak/realm.json · .env.example" style="fillColor=#ffffff;strokeColor=#666666;fontSize=10;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;fontFamily=Courier New;html=0;" vertex="1" parent="s2">
     <mxGeometry x="10" y="34" width="640" height="262" as="geometry" />
    </mxCell>
    <mxCell id="code" value="type Connector interface {&#10;    Name() string&#10;    Pull(ctx context.Context, cursor string) (items []RawItem, next string, err error)&#10;    Permissions(ctx context.Context, it RawItem) ([]Principal, error)&#10;}&#10;type Parser interface {&#10;    Accepts(mime string) bool&#10;    Parse(ctx context.Context, it RawItem) (envelope.Document, error)&#10;}&#10;type Embedder interface {&#10;    Embed(ctx context.Context, texts []string) ([][]float32, error)&#10;    Model() ModelInfo&#10;}&#10;type Signal interface { Name() string; Score(ctx context.Context, c Candidate) float64 } // 0.5..1.5&#10;type EventBus interface {&#10;    Publish(ctx context.Context, tx Tx, e Event) error&#10;    Handle(typ string, h Handler)&#10;}&#10;&#10;// регистрация: одна строка на реализацию; всё собирается в main.go из конфига&#10;reg := connector.NewRegistry()&#10;reg.Register(&quot;files&quot;, files.New)            // func(cfg) (Connector, error)&#10;reg.Register(&quot;notes&quot;, notes.New)&#10;chain := search.NewChain(cfg.Search.Signals, freshness.New, authority.New, quality.New)" style="fillColor=#ffffff;strokeColor=#666666;fontSize=9.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;fontFamily=Courier New;html=0;" vertex="1" parent="s2">
     <mxGeometry x="10" y="304" width="640" height="306" as="geometry" />
    </mxCell>
    <mxCell id="root" value="&lt;b&gt;cmd/kb/main.go — composition root&lt;/b&gt;&lt;br&gt;config → Registry/Factory → явный DI → режим: api | worker | migrate | reindex | eval" style="fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s2">
     <mxGeometry x="670" y="34" width="610" height="52" as="geometry" />
    </mxCell>
    <mxCell id="L1" value="&lt;b&gt;Transport / entrypoints&lt;/b&gt;" style="fillColor=#ffffff;strokeColor=#666666;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=4;verticalAlign=top;strokeWidth=1.5;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s2">
     <mxGeometry x="670" y="106" width="610" height="68" as="geometry" />
    </mxCell>
    <mxCell id="L1_0" value="&lt;b&gt;HTTP API&lt;/b&gt;&lt;br&gt;chi + oapi-codegen" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=center;spacingTop=5;html=1;" vertex="1" parent="L1">
     <mxGeometry x="8" y="24" width="142" height="32" as="geometry" />
    </mxCell>
    <mxCell id="L1_1" value="&lt;b&gt;MCP server&lt;/b&gt;&lt;br&gt;go-sdk" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=center;spacingTop=5;html=1;" vertex="1" parent="L1">
     <mxGeometry x="156" y="24" width="142" height="32" as="geometry" />
    </mxCell>
    <mxCell id="L1_2" value="&lt;b&gt;River workers&lt;/b&gt;&lt;br&gt;jobs/*" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=center;spacingTop=5;html=1;" vertex="1" parent="L1">
     <mxGeometry x="304" y="24" width="142" height="32" as="geometry" />
    </mxCell>
    <mxCell id="L1_3" value="&lt;b&gt;CLI&lt;/b&gt;&lt;br&gt;migrate · reindex · eval" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=center;spacingTop=5;html=1;" vertex="1" parent="L1">
     <mxGeometry x="452" y="24" width="142" height="32" as="geometry" />
    </mxCell>
    <mxCell id="L2" value="&lt;b&gt;Use-cases: internal/&amp;lt;feature&amp;gt;&lt;/b&gt;" style="fillColor=#ffffff;strokeColor=#666666;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=4;verticalAlign=top;strokeWidth=1.5;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s2">
