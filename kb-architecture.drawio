    </mxCell>
    <mxCell id="rb0" value="Пакет connector/&amp;lt;имя&amp;gt; реализует Connector; одна строка в connector.Registry; запись source в PG; маппинг внешних прав в resource groups через Permissions()." style="fillColor=#ffffff;strokeColor=#666666;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s3">
     <mxGeometry x="258" y="66" width="520" height="68" as="geometry" />
    </mxCell>
    <mxCell id="rc0" value="envelope, пайплайн, индекс, ACL-фильтр" style="fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s3">
     <mxGeometry x="786" y="66" width="274" height="68" as="geometry" />
    </mxCell>
    <mxCell id="ra1" value="Новый формат файла" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;spacingRight=6;html=1;" vertex="1" parent="s3">
