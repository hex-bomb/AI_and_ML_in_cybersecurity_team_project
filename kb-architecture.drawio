    </mxCell>
    <mxCell id="L2_5" value="&lt;b&gt;feedback&lt;/b&gt;" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=center;spacingTop=5;html=1;" vertex="1" parent="L2">
     <mxGeometry x="8.0" y="60" width="114.0" height="32" as="geometry" />
    </mxCell>
    <mxCell id="L2_6" value="&lt;b&gt;graph&lt;/b&gt;" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=center;spacingTop=5;html=1;" vertex="1" parent="L2">
