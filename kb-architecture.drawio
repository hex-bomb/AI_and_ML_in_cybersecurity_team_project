    <mxCell id="L2_2" value="&lt;b&gt;access&lt;/b&gt;&lt;br&gt;AGDLP" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9.5;whiteSpace=wrap;rounded=1;arcSize=8;verticalAlign=top;align=center;spacingTop=5;html=1;" vertex="1" parent="L2">
