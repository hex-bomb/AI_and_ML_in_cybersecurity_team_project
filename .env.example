 # Postgres
POSTGRES_PASSWORD=vektor-dev

# Секреты (генерируются автоматически, оставьте пустыми)
# RSA-ключ подписи JWT.
AUTH_SIGNING_KEY_B64=
# Общий токен для /internal/* эндпоинтов documents.
DOCUMENTS_INTERNAL_TOKEN=

# Демо-аккаунты (профиль dev)
AUTH_DEV_ADMIN_PASSWORD=dev-admin-password

LLM_PROVIDER=gigachat
LLM_BASE_URL=https://api.giga.chat/v1/
LLM_MODEL=GigaChat
LLM_API_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
